AI_UD_LIVE_SERVICES=false
# Copy this file to .env.local and fill in your key.
# The app works fully without it (deterministic fallback engine), this only
# enables live Gemini-powered complexity scoring + NER.
GEMINI_API_KEY=

# Optional: override the hosted chuk-mcp-solver MCP endpoint used for the
# Optimization Node. Defaults to https://solver.chukai.io/mcp if unset.
MCP_SOLVER_URL=https://solver.chukai.io/mcp

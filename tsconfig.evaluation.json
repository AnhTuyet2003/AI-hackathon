{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "outDir": ".evaluation-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["evaluation/care/**/*.ts", "lib/care-routing.ts"],
  "exclude": ["node_modules", "reference", ".next", ".evaluation-build"]
}
